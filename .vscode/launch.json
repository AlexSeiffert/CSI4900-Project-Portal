{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "uoProjects Frontend",
      "type": "node-terminal",
      "request": "launch",
      "command": "dotnet watch --project frontend/uoProjects --launch-profile http-watch",
      "cwd": "${workspaceFolder}",
      "env": {
        "DOTNET_WATCH_RESTART_ON_RUDE_EDIT": "true"
      }
    },
    {
      "name": "uoProjects CSS",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run css:watch",
      "cwd": "${workspaceFolder}/frontend/uoProjects"
    },
    {
      "name": "uoProjects API",
      "type": "node-terminal",
      "request": "launch",
      "command": "dotnet run --project backend/API --launch-profile https-supabase",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "name": "uoProjects API (Debugger)",
      "type": "coreclr",
      "request": "launch",
      "envFile": "${workspaceFolder}/.env",
      "preLaunchTask": "build-api",
      "program": "${workspaceFolder}/backend/API/bin/Debug/net10.0/API.dll",
      "cwd": "${workspaceFolder}/backend/API",
      "launchSettingsProfile": "https-supabase",
      "console": "internalConsole",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https://\\S+)",
        "uriFormat": "%s/swagger"
      }
    }
  ],
  "compounds": [
    {
      "name": "uoProjects (Full Stack)",
      "configurations": ["uoProjects API", "uoProjects Frontend", "uoProjects CSS"],
      "stopAll": true
    }
  ]
}
