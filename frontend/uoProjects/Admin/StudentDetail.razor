@if (student is null)
{
    <BackLink Href="@($"{BasePath}/students")" Label="All students" />
    <p class="mt-6 text-text-secondary">@(loaded ? "This student no longer exists." : "Loading…")</p>
}
else
{
    var inquiries = Data.InquiriesFrom(student.UserId).ToList();
    <RecordHeader Title="@student.DisplayName" BackHref="@($"{BasePath}/students")" BackLabel="All students">
        <StatusPill Status="@Display.Stage(Data.FurthestStage(student.UserId))" />
        <span class="inline-flex items-center gap-1.5"><Icon Name="send" />@inquiries.Count @(inquiries.Count == 1 ? "inquiry" : "inquiries")</span>
        <span class="inline-flex items-center gap-1.5"><Icon Name="bookmark" />@savedProjects.Count saved</span>
    </RecordHeader>

    <div class="mt-8 grid items-start gap-4 lg:grid-cols-[2fr_3fr]">
        <form class="card space-y-5" @onsubmit="SaveAsync" @onsubmit:preventDefault>
            <h2 class="text-lg font-semibold">Profile</h2>
            <FormField Label="Interested in" Group>
                <TopicPicker Topics="Data.Topics" Selected="topics" Label="Interested in" Disabled="!Actions.CanSave" OnChange="() => saved = false" />
            </FormField>
            <SaveBar Busy="busy" Saved="saved" Error="@error" />
        </form>

        <div class="grid gap-4">
            <Panel Title="Inquiries" Flush>
                <InquiryTable Inquiries="inquiries" Data="Data" BasePath="@BasePath" ShowStudent="false" Empty="Hasn't sent an inquiry yet." />
            </Panel>
            <Panel Title="Saved projects" Flush>
                <DataTable Items="savedProjects" ExportName="saved-projects" SortedBy="Project" Empty="@(Actions.CanSave ? "Nothing saved." : "Not available in the preview.")">
                    <DataColumn Title="Project" SortBy="p => p.Title" Class="max-w-80 truncate">
                        <a class="hover:text-focus hover:underline" href="@($"{BasePath}/projects/{context.Id}")" title="@context.Title">@context.Title</a>
                    </DataColumn>
                    <DataColumn Title="Inquired" SortBy="p => inquiries.Any(i => i.ProjectId == p.Id)">
                        @if (inquiries.Any(i => i.ProjectId == context.Id))
                        {
                            <span class="inline-flex items-center gap-1.5"><Icon Name="check" Class="size-4 text-text-secondary" />Yes</span>
                        }
                        else
                        {
                            <span class="text-text-secondary">Not yet</span>
                        }
                    </DataColumn>
                </DataTable>
            </Panel>
        </div>
    </div>
}

@code {
    [CascadingParameter] public AdminActions Actions { get; set; } = default!;
    [Parameter, EditorRequired] public AdminData Data { get; set; } = default!;
    [Parameter, EditorRequired] public string BasePath { get; set; } = "";
    [Parameter, EditorRequired] public Guid Id { get; set; }

    private Student? student;
    private List<Project> savedProjects = [];
    private Guid? loadedId;
    private bool loaded;
    private HashSet<Guid> topics = [];
    private bool busy;
    private bool saved;
    private string? error;

    protected override async Task OnParametersSetAsync()
    {
        if (loadedId == Id)
        {
            student = Data.Student(Id) is { } fresh ? fresh with { TopicInterests = student?.TopicInterests } : null;
            return;
        }
        loadedId = Id;
        loaded = false;
        saved = false;
        error = null;
        student = await Actions.GetAsync($"students/{Id}", Data.Student(Id));
        savedProjects = await Actions.GetAsync($"students/{Id}/saved-projects", new List<Project>()) ?? [];
        loaded = true;
        if (student is not null)
        {
            topics = [.. (student.TopicInterests ?? []).Select(t => t.Id)];
        }
    }

    private async Task SaveAsync()
    {
        busy = true;
        saved = false;
        var body = new UpdateStudent(student!.DisplayName, [.. topics]);
        error = await Actions.SaveAsync(api => api.PutAsync<Student>($"students/{Id}", body));
        saved = error is null;
        busy = false;
    }
}
