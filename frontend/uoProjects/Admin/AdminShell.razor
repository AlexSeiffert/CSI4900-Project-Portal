<div class="grid grid-cols-[64px_minmax(0,1fr)] min-[700px]:grid-cols-[232px_minmax(0,1fr)]">
<aside class="sticky top-0 flex h-dvh flex-col overflow-y-auto border-r border-border bg-dark px-2 py-4 min-[700px]:px-6 min-[700px]:py-8">
    <a href="@BasePath" class="mx-auto mb-8 block w-12 shrink-0 min-[700px]:w-40">
        <picture>
            <source media="(max-width: 699px)" srcset="brand/uoProjectsLogo-minimal.svg" />
            <img src="brand/uoProjectsLogo.svg" alt="uoProjects" class="h-auto w-full" />
        </picture>
    </a>
    <nav aria-label="Admin sections" class="flex flex-col gap-2">
        @foreach (var (key, label) in Tabs)
        {
            var active = key == Current;
            <a href="@HrefFor(key)" aria-current="@(active ? "page" : null)" title="@label" class="side-link">
                <Icon Name="@IconFor(key)" Class="size-5" />
                <span class="sr-only min-[700px]:not-sr-only">@label</span>
            </a>
        }
    </nav>
    <div class="mt-auto flex flex-col gap-2 pt-6">
        <p class="hidden break-words px-2 text-[11px] leading-snug text-text-faint min-[700px]:block" title="@UserName">@UserName</p>
        <MudButton Variant="Variant.Outlined" DropShadow="false" DisableRipple="true" title="Sign out" OnClick="@OnSignOut"
                           Class="btn btn-secondary btn-sm w-full max-[699px]:px-0">
            <Icon Name="log-out" />
            <span class="sr-only min-[700px]:not-sr-only">Sign out</span>
        </MudButton>
    </div>
</aside>

<div class="flex min-w-0 flex-col">
<CascadingValue Value="exports" IsFixed="true">
<div class="relative mx-auto w-full max-w-6xl flex-1 px-4 py-8 sm:px-6 sm:py-12">
    <div class="absolute right-4 top-[2.125rem] z-10 sm:right-6 sm:top-[3.375rem]"><ExportMenu Host="exports" /></div>

    @if (ItemId is null)
    {
        <h1 class="mb-8 text-4xl font-bold leading-[1.1] tracking-tighter sm:mb-10 sm:text-5xl">@TitleOf(Current)</h1>
    }

    @if (Error is not null)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Text" NoIcon="true" Class="alert">@Error</MudAlert>
    }
    else if (Data is null)
    {
        <p class="text-text-secondary">Loading…</p>
    }
    else
    {
        <CascadingValue Value="Actions" IsFixed="true">
            @switch (Current)
            {
                case "students" when RecordId is { } id: <StudentDetail Data="Data" BasePath="@BasePath" Id="id" /> break;
                case "students": <StudentsTab Data="Data" BasePath="@BasePath" /> break;
                case "supervisors" when RecordId is { } id: <SupervisorDetail Data="Data" BasePath="@BasePath" Id="id" /> break;
                case "supervisors": <SupervisorsTab Data="Data" BasePath="@BasePath" /> break;
                case "projects" when ItemId is not null: <ProjectDetail Data="Data" BasePath="@BasePath" Id="RecordId" /> break;
                case "projects": <ProjectsTab Data="Data" BasePath="@BasePath" /> break;
                default: <InsightsTab Data="Data" BasePath="@BasePath" /> break;
            }
        </CascadingValue>
    }
</div>
</CascadingValue>
<SiteFooter />
</div>
</div>

@code {
    public static readonly (string Key, string Label)[] Tabs =
        [("insights", "Insights"), ("students", "Students"), ("supervisors", "Supervisors"), ("projects", "Projects")];

    public static string Normalize(string? tab) =>
        Tabs.FirstOrDefault(t => t.Key == tab?.ToLowerInvariant()).Key ?? Tabs[0].Key;

    public static string TitleOf(string key) => Tabs.First(t => t.Key == key).Label;

    [Parameter, EditorRequired] public string Current { get; set; } = "";
    [Parameter, EditorRequired] public string BasePath { get; set; } = "";
    [Parameter, EditorRequired] public string UserName { get; set; } = "";
    [Parameter] public AdminData? Data { get; set; }
    [Parameter] public string? Error { get; set; }
    [Parameter, EditorRequired] public AdminActions Actions { get; set; } = default!;
    [Parameter] public string? ItemId { get; set; }
    [Parameter] public EventCallback OnSignOut { get; set; }

    private readonly ExportHost exports = new();

    private Guid? RecordId => Guid.TryParse(ItemId, out var id) ? id : null;

    private static string IconFor(string key) => key switch
    {
        "students" => "graduation-cap",
        "supervisors" => "user-round",
        "projects" => "folder-open",
        _ => "layout-dashboard",
    };

    private string HrefFor(string key) => key == "insights" ? BasePath : $"{BasePath}/{key}";
}
