@namespace uoProjects.Admin
<div class="mt-6 flex flex-wrap items-center gap-4">
    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" DropShadow="false" Ripple="false" Class="btn btn-sm" Disabled="@(Busy || !Actions.CanSave)">@(Busy ? "Saving…" : Label)</MudButton>
    @if (Error is not null)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Text" NoIcon="true" Class="alert">@Error</MudAlert>
    }
    else if (Saved)
    {
        <p role="status" class="inline-flex items-center gap-1.5 text-sm font-semibold text-success-text">
            <Icon Name="check" StrokeWidth="2.5" />
            Saved
        </p>
    }
    else if (!Actions.CanSave)
    {
        <p class="text-sm text-text-secondary">Preview only: changes aren't saved.</p>
    }
    @ChildContent
</div>

@code {
    [CascadingParameter] public AdminActions Actions { get; set; } = default!;
    [Parameter] public string Label { get; set; } = "Save changes";
    [Parameter] public bool Busy { get; set; }
    [Parameter] public bool Saved { get; set; }
    [Parameter] public string? Error { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
