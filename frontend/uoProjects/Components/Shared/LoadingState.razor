<div role="status">
    <span class="sr-only">@Message</span>
    <div class="motion-safe:animate-pulse" aria-hidden="true">
        @if (Layout == SkeletonLayout.Detail)
        {
            <div class="mb-8 h-10 w-2/3 max-w-md rounded-lg bg-border"></div>
            <div class="grid gap-4 lg:grid-cols-[2fr_3fr]">
                <div class="space-y-6 rounded-xl border border-border bg-surface p-6">
                    @for (var field = 0; field < 4; field++)
                    {
                        <div class="space-y-3">
                            <div class="h-3 w-24 rounded bg-border"></div>
                            <div class="h-8 rounded bg-surface-hover"></div>
                        </div>
                    }
                </div>
                <div class="min-h-48 space-y-5 rounded-xl border border-border bg-surface p-6">
                    <div class="h-5 w-1/3 rounded bg-border"></div>
                    <div class="h-4 w-4/5 rounded bg-surface-hover"></div>
                    <div class="h-4 w-3/5 rounded bg-surface-hover"></div>
                </div>
            </div>
        }
        else if (Layout == SkeletonLayout.Dashboard)
        {
            <div class="mb-4 grid grid-cols-2 gap-4 lg:grid-cols-4">
                @for (var card = 0; card < 4; card++)
                {
                    <div class="space-y-4 rounded-xl border border-border bg-surface p-5">
                        <div class="h-3 w-2/3 rounded bg-border"></div>
                        <div class="h-7 w-1/2 rounded bg-surface-hover"></div>
                    </div>
                }
            </div>
            <div class="h-64 rounded-xl border border-border bg-surface"></div>
        }
        else
        {
            <div class="divide-y divide-border rounded-xl border border-border bg-surface">
                <div class="px-5 py-4"><div class="h-3 w-1/4 rounded bg-border"></div></div>
                @for (var row = 0; row < 6; row++)
                {
                    <div class="grid grid-cols-[2fr_1fr_1fr] gap-4 px-5 py-4">
                        <div class="h-4 w-4/5 rounded bg-surface-hover"></div>
                        <div class="h-4 w-3/4 rounded bg-surface-hover"></div>
                        <div class="h-4 w-1/2 rounded bg-surface-hover"></div>
                    </div>
                }
            </div>
        }
    </div>
</div>

@code {
    public enum SkeletonLayout { Table, Detail, Dashboard }

    [Parameter] public SkeletonLayout Layout { get; set; }
    [Parameter] public string Message { get; set; } = "Loading…";
}
