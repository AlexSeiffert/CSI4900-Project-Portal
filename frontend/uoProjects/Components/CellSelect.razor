<span class="app-select-wrap app-cell-select-wrap @(Disabled ? "is-disabled" : "")">
    <span class="app-select-sizer" aria-hidden="true">
        @if (Dot is not null)
        {
            <span class="size-2 shrink-0"></span>
        }
        <span class="app-select-sizer-options">
            @foreach (var option in Options)
            {
                <span>@option.Label</span>
            }
        </span>
    </span>
    <MudSelect T="string" Value="Value" ValueChanged="OnChange" Disabled="Disabled" Variant="Variant.Text" Underline="false" Margin="Margin.None"
               Adornment="Adornment.End" Style="@(Dot is null ? "--cell-dot-display: none" : $"--cell-dot: {Dot}")" OpenIcon="@LucideIcons.Svg("chevron-down")" CloseIcon="@LucideIcons.Svg("chevron-down")"
               AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft" Dense="true" Class="app-cell-select" aria-label="@Label">
        @foreach (var option in Options)
        {
            <MudSelectItem T="string" Value="@option.Value">@option.Label</MudSelectItem>
        }
    </MudSelect>
</span>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter] public string? Value { get; set; }
    [Parameter] public string? Dot { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback<string?> OnChange { get; set; }
    [Parameter, EditorRequired] public IEnumerable<(string Value, string Label)> Options { get; set; } = [];
}
