@using Microsoft.AspNetCore.Components.Routing
@using MudBlazor
@using uoProjects.Components.Shared

@inherits LayoutComponentBase

<MudThemeProvider Theme="uoProjects.Theming.AppTheme.Brand" IsDarkMode="true" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<a class="skip-link" href="#main-content">Skip to content</a>
<div class="site-shell">
    <aside class="site-sidebar" aria-label="Site sidebar">
        <a class="brand" href="/" aria-label="uoProjects home">
            <picture>
                <source media="(max-width: 700px)" srcset="svg/uoProjectsLogo-minimal.svg" width="499" height="582" />
                <img src="svg/uoProjectsLogo.svg" alt="uoProjects" width="874" height="584" />
            </picture>
        </a>
        <nav class="site-nav" aria-label="Main navigation">
            <NavLink href="/" Match="NavLinkMatch.All" title="Home">
                <MudIcon Icon="@Icons.Material.Outlined.Home" aria-hidden="true" />
                <span>Home</span>
            </NavLink>
            <NavLink href="projects" title="Projects">
                <MudIcon Icon="@Icons.Material.Outlined.Science" aria-hidden="true" />
                <span>Projects</span>
            </NavLink>
            <NavLink href="supervisors" title="Supervisors">
                <MudIcon Icon="@Icons.Material.Outlined.Groups" aria-hidden="true" />
                <span>Supervisors</span>
            </NavLink>
        </nav>
        <nav class="site-nav account-nav" aria-label="Account navigation">
            <NavLink href="user" title="My Profile">
                <MudIcon Icon="@Icons.Material.Outlined.Person" aria-hidden="true" />
                <span>My Profile</span>
            </NavLink>
        </nav>
    </aside>

    <div class="site-content">
        <main id="main-content" class="site-container site-main" tabindex="-1">
            @Body
        </main>

        <SiteFooter />
    </div>
</div>
