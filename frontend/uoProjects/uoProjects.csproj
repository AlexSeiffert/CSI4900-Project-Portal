<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.13" PrivateAssets="all" />
    <PackageReference Include="MudBlazor" Version="9.12.0" GeneratePathProperty="true" />
  </ItemGroup>

  <Target Name="CopyBrandAssets" BeforeTargets="BeforeBuild">
    <ItemGroup>
      <BrandAsset Include="../public/**" />
    </ItemGroup>
    <Copy SourceFiles="@(BrandAsset)" DestinationFiles="@(BrandAsset->'wwwroot/brand/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="WriteDevSettings" BeforeTargets="BeforeBuild" Condition="'$(Auth__Authority)' != '' and '$(SUPABASE_PUBLISHABLE_KEY)' != ''">
    <WriteLinesToFile File="wwwroot/appsettings.Development.json" Overwrite="true" WriteOnlyWhenDifferent="true" Lines="{ &quot;Supabase&quot;: { &quot;AuthUrl&quot;: &quot;$(Auth__Authority)&quot;, &quot;PublishableKey&quot;: &quot;$(SUPABASE_PUBLISHABLE_KEY)&quot; } }" />
    <ItemGroup>
      <Content Include="wwwroot/appsettings.Development.json" Exclude="@(Content)" />
    </ItemGroup>
  </Target>

  <Target Name="BuildTailwind" BeforeTargets="BeforeBuild" Condition="'$(SkipTailwind)' != 'true'">
    <Exec Command="npm ci --no-audit --no-fund" Condition="!Exists('node_modules/.bin/tailwindcss')" WorkingDirectory="$(MSBuildProjectDirectory)" />
    <Exec Command="node Styles/prepare-mud.mjs &quot;$(PkgMudBlazor)/staticwebassets/MudBlazor.min.css&quot; Styles/vendor/MudBlazor.min.css" WorkingDirectory="$(MSBuildProjectDirectory)" />
    <Exec Command="npm run css:build" WorkingDirectory="$(MSBuildProjectDirectory)" />
    <ItemGroup>
      <Content Include="wwwroot/css/portal.css" Exclude="@(Content)" />
    </ItemGroup>
  </Target>

</Project>
