@* A white panel with an optional heading, description and actions on the right. Flush drops the inner
   padding so a table can run edge to edge (DataTable lines its outer columns up with the heading). *@
<section class="card @(Flush ? "px-0 py-0 sm:px-0 sm:py-0" : "") @Class" aria-label="@Title">
    @if (Title is not null)
    {
        <header class="flex flex-wrap items-start justify-between gap-x-4 gap-y-2 @(Flush ? "px-5 pb-2 pt-5 sm:px-6 sm:pt-6" : "mb-4")">
            <div>
                <h2 class="text-lg font-semibold">@Title</h2>
                @if (Description is not null)
                {
                    <p class="text-sm text-muted">@Description</p>
                }
            </div>
            @Actions
        </header>
    }
    @ChildContent
</section>

@code {
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Description { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public bool Flush { get; set; }
    [Parameter] public string? Class { get; set; }
}
