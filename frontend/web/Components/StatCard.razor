<MudLink Href="@Href" Underline="Underline.None" Color="Color.Inherit" Class="group flex min-w-0 flex-col rounded-2xl bg-surface p-6 text-text">
    <span class="label text-text-secondary">@Label</span>
    <span class="mt-5 flex items-baseline gap-2">
        <span class="text-5xl font-bold leading-none tracking-tighter tabular-nums">@Value</span>
        @if (Unit is not null)
        {
            <span class="text-lg font-semibold text-text-faint">@Unit</span>
        }
    </span>
    <span class="mt-3 text-sm leading-snug text-text-secondary">@Note</span>
    <span class="mt-auto pt-6">
        <span class="flex items-center border-t border-border pt-4 text-sm font-semibold">@LinkText<Arrow /></span>
    </span>
</MudLink>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter, EditorRequired] public string Value { get; set; } = "";
    [Parameter, EditorRequired] public string Href { get; set; } = "";
    [Parameter, EditorRequired] public string LinkText { get; set; } = "";
    [Parameter] public string? Unit { get; set; }
    [Parameter] public string? Note { get; set; }
}
