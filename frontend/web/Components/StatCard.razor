@* A headline figure as a flat white block: label, number, one line of context, and a link to the list
   behind it under a thin rule. On hover the arrow slides, like the site's buttons. *@
<a href="@Href" class="group flex min-w-0 flex-col rounded-2xl bg-white p-6 text-dark">
    <span class="label text-muted">@Label</span>
    <span class="mt-5 flex items-baseline gap-2">
        <span class="text-5xl font-bold leading-none tracking-tighter tabular-nums">@Value</span>
        @if (Unit is not null)
        {
            <span class="text-lg font-semibold text-faint">@Unit</span>
        }
    </span>
    <span class="mt-3 text-sm leading-snug text-muted">@Note</span>
    <span class="mt-auto pt-6">
        <span class="flex items-center border-t border-divider pt-4 text-sm font-semibold">@LinkText<Arrow /></span>
    </span>
</a>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter, EditorRequired] public string Value { get; set; } = "";
    [Parameter, EditorRequired] public string Href { get; set; } = "";
    [Parameter, EditorRequired] public string LinkText { get; set; } = "";
    [Parameter] public string? Unit { get; set; }
    [Parameter] public string? Note { get; set; }
}
