@* A pill-shaped menu for toolbars, labelled inside the pill. Bind with @bind-Value; options go inside. *@
<label class="control relative pr-8">
    @if (IconName is not null)
    {
        <Icon Name="@IconName" Class="size-4 text-muted" />
    }
    <span class="shrink-0 text-muted">@Label</span>
    <select value="@Value" @onchange="e => ValueChanged.InvokeAsync(e.Value?.ToString() ?? string.Empty)" class="font-semibold">
        @ChildContent
    </select>
    <Icon Name="chevron-down" Class="pointer-events-none absolute right-3 size-4 text-muted" />
</label>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter] public string? IconName { get; set; }
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
