@* The row above a list: filters on the left, search and actions on the right. Everything in it is the
   same height (chips, .control and .btn-sm), so it lines up whether it fits on one line or wraps. *@
<div class="flex flex-wrap items-center justify-between gap-3">
    <div class="flex flex-wrap items-center gap-2">@Start</div>
    <div class="flex flex-wrap items-center gap-2">@End</div>
</div>

@code {
    [Parameter] public RenderFragment? Start { get; set; }
    [Parameter] public RenderFragment? End { get; set; }
}
