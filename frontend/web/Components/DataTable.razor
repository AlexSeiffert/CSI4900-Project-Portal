@typeparam TItem
@attribute [CascadingTypeParameter(nameof(TItem))]

@* A table whose columns are declared as <DataColumn> children. Columns with a SortBy can be sorted
   by clicking their heading: once for one direction, again for the other.

   <DataTable Items="projects" SortedBy="Title">
       <DataColumn Title="Title" SortBy="p => p.Title">@context.Title</DataColumn>
   </DataTable> *@
<CascadingValue Value="this" IsFixed="true">@ChildContent</CascadingValue>

@if (!Items.Any())
{
    <p class="px-5 py-6 text-muted sm:px-6">@Empty</p>
}
else
{
    <div class="overflow-x-auto">
        <table class="data-table">
            <thead>
                <tr>
                    @foreach (var column in columns)
                    {
                        var active = column == sortColumn;
                        <th scope="col" class="@column.Class" aria-sort="@(active ? (descending ? "descending" : "ascending") : null)">
                            @if (column.SortBy is null)
                            {
                                @column.Title
                            }
                            else
                            {
                                <button type="button" class="th-sort" data-active="@(active ? "" : null)" @onclick="() => SortOn(column)">
                                    @column.Title
                                    <Icon Name="@(active ? (descending ? "chevron-down" : "chevron-up") : "chevrons-up-down")" Class="size-3.5" StrokeWidth="2.5" />
                                </button>
                            }
                        </th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Sorted())
                {
                    <tr>
                        @foreach (var column in columns)
                        {
                            <td class="@column.Class">@column.ChildContent(item)</td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    [Parameter, EditorRequired] public IEnumerable<TItem> Items { get; set; } = [];
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string Empty { get; set; } = "Nothing here yet.";
    /// <summary>The title of the column to sort by at first.</summary>
    [Parameter] public string? SortedBy { get; set; }

    private readonly List<DataColumn<TItem>> columns = [];
    private DataColumn<TItem>? sortColumn;
    private bool descending;

    internal void Add(DataColumn<TItem> column)
    {
        columns.Add(column);
        if (column.Title == SortedBy)
        {
            sortColumn = column;
            descending = column.DescendingFirst;
        }
        StateHasChanged();
    }

    private void SortOn(DataColumn<TItem> column)
    {
        descending = column == sortColumn ? !descending : column.DescendingFirst;
        sortColumn = column;
    }

    private IEnumerable<TItem> Sorted()
    {
        if (sortColumn?.SortBy is not { } key)
        {
            return Items;
        }
        var comparer = Comparer<object?>.Create(Compare);
        return descending ? Items.OrderByDescending(key, comparer) : Items.OrderBy(key, comparer);
    }

    // Text sorts ignoring case; empty values always go last.
    private static int Compare(object? a, object? b) => (a, b) switch
    {
        (null, null) => 0,
        (null, _) => 1,
        (_, null) => -1,
        (string x, string y) => string.Compare(x, y, StringComparison.CurrentCultureIgnoreCase),
        _ => Comparer<object>.Default.Compare(a, b),
    };
}
