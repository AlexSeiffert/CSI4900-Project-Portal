@inject AuthSession Auth
@inject NavigationManager Nav

@* Placeholder home page for one role: the signed-in user's role, name and a sign-out button. *@
<RoleGate Role="@Role" Context="user">
    <div class="flex flex-1 flex-col items-center justify-center px-6 py-8 text-center">
        <p class="label mb-2 text-muted">@user.Role</p>
        <h1 class="text-4xl font-bold leading-[1.1] tracking-tighter sm:text-5xl">@user.Name</h1>
        <button type="button" class="group btn mt-8 w-full max-w-xs" @onclick="SignOutAsync">
            Sign out
            <Arrow />
        </button>
    </div>
</RoleGate>

@code {
    [Parameter, EditorRequired] public string Role { get; set; } = "";

    private async Task SignOutAsync()
    {
        await Auth.SignOutAsync();
        Nav.NavigateTo("/login", replace: true);
    }
}
